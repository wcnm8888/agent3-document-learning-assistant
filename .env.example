# 仅作本地配置模板；真实密钥只写入未提交的项目根目录 .env。
EMBED_MODEL_NAME=text-embedding-v4
EMBED_VECTOR_DIMENSION=1024
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_BATCH_SIZE=10
EMBED_MAX_RETRIES=3
EMBED_RETRY_BACKOFF_SECONDS=1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=data/qdrant
QDRANT_TIMEOUT=10
QDRANT_COLLECTION_PREFIX=docqa

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
# 默认不继承系统代理；需要代理时设为 true，并确保 httpx[socks] 已安装
DEEPSEEK_TRUST_ENV=false
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=1

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.45
RETRIEVAL_CONTEXT_MAX_CHARS=12000
SQLITE_PATH=data/docqa.sqlite3
MEMORY_TURN_LIMIT=6
MEMORY_CONTEXT_MAX_CHARS=4000
CHUNK_SIZE=1200
CHUNK_OVERLAP=160

# 运行边界：应用默认只监听本机，生产环境不得直接复用此模板。
# Gradio 入口也支持 GRADIO_SERVER_NAME/GRADIO_SERVER_PORT，默认 127.0.0.1:7860。
